{
  "description": "所有场景 PNG 与 interior/outpost_base.png 同尺寸、同原点。仅设置覆盖顺序和状态，不单独调整大小或位置。",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "referenceImage": "assets/scene/interior/outpost_base.png"
  },
  "layers": [
    {
      "id": "exterior-main",
      "bind": "weather",
      "zIndex": 10,
      "defaultState": "clear",
      "states": {
        "clear": {
          "src": "assets/scene/exterior/main/clear.png"
        },
        "sandstorm": {
          "sequence": {
            "pattern": "assets/scene/exterior/main/sandstorm/frame_{index}.png",
            "start": 1,
            "count": 6,
            "pad": 2
          },
          "fps": 6,
          "playback": "ping-pong"
        }
      }
    },
    {
      "id": "exterior-right",
      "bind": "weather",
      "zIndex": 12,
      "defaultState": "clear",
      "states": {
        "clear": {
          "src": "assets/scene/exterior/right/clear.png"
        },
        "sandstorm": {
          "sequence": {
            "pattern": "assets/scene/exterior/right/sandstorm/frame_{index}.png",
            "start": 1,
            "count": 6,
            "pad": 2
          },
          "fps": 6,
          "playback": "ping-pong"
        }
      }
    },
    {
      "id": "solar-dust",
      "bind": "panels",
      "zIndex": 16,
      "defaultState": "clean",
      "states": {
        "clean": {
          "hidden": true
        },
        "dusty": {
          "src": "assets/scene/exterior/main/panels_dust.png"
        }
      }
    },
    {
      "id": "greenhouse",
      "bind": "plants",
      "zIndex": 25,
